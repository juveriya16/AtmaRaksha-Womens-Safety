<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Hero Section with Indian Woman Cartoon Illustration & Sunrise Gradient -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@drawable/bg_hero_gradient_sunrise">

            <!-- Hero Illustration -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_indian_woman_safety" />

            <!-- Soft Gradient Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/bg_hero_gradient_sunrise"
                android:alpha="0.9" />

            <!-- Floating Top Brand Monogram Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_pill_button_lavender"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_atmaraksha_shield_lotus" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="AtmaRaksha"
                        android:textColor="@color/brand_purple"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:text="Your Safety. Your Freedom."
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        app:fontFamily="@font/poppins_medium" />
                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>

        <!-- Bottom Action Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-28dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="36dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to AtmaRaksha"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/poppins_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your Safety. Your Freedom."
                    android:textColor="@color/brand_pink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/poppins_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Safe navigation routes, instant SOS with live GPS, privacy device scanning, and verified emergency assistance."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    app:fontFamily="@font/poppins" />

                <!-- Action Button 1: "Get Started" matching reference screenshot -->
                <Button
                    android:id="@+id/btn_welcome_get_started"
                    style="@style/Widget.AtmaRaksha.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_pill_button_pink"
                    android:text="Get Started"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/poppins_bold" />

                <!-- Action Button 2: "Log In" matching reference screenshot -->
                <Button
                    android:id="@+id/btn_welcome_login"
                    style="@style/Widget.AtmaRaksha.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Log In"
                    android:textColor="@color/brand_purple"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/poppins_medium" />

                <!-- Action Button 3: Quick Demo Mode -->
                <Button
                    android:id="@+id/btn_welcome_demo"
                    style="@style/Widget.AtmaRaksha.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/brand_lavender"
                    android:text="⚡ Quick Demo Mode"
                    android:textColor="@color/brand_purple" />

                <!-- Footnote: Terms & Privacy Policy link -->
                <TextView
                    android:id="@+id/tv_welcome_privacy_footnote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="By continuing, you agree to our Terms of Service and Privacy Policy"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    app:fontFamily="@font/poppins" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
