<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_manual_sos_bar"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header Banner -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <ImageView
                    android:id="@+id/btn_back_voice_sos"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="Voice-Activated SOS"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/poppins_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="26dp"
                    android:text="Hands-free emergency voice trigger"
                    android:textColor="@color/brand_lavender"
                    android:textSize="11sp"
                    app:fontFamily="@font/poppins" />
            </RelativeLayout>

            <!-- 1. Voice Listener Arming & Waveform Card -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.AtmaRaksha.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <FrameLayout
                        android:id="@+id/layout_mic_pulsing_ring"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_circle_lavender">

                        <ImageView
                            android:id="@+id/iv_mic_status"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_microphone"
                            app:tint="@color/brand_purple" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_voice_status_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Voice Listener: Standby"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:id="@+id/tv_detected_speech_snippet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Tap 'Arm Voice Trigger' to begin continuous hands-free voice recognition."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:fontFamily="@font/poppins" />

                    <Button
                        android:id="@+id/btn_toggle_voice_listener"
                        style="@style/Widget.AtmaRaksha.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="48dp"
                        android:text="Arm Voice Trigger (Active Session)"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. Configurable Activation Phrase Card -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.AtmaRaksha.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗣️ Emergency Activation Phrase"
                        android:textColor="@color/brand_purple"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Saying this phrase clearly will trigger emergency SOS escalation:"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        app:fontFamily="@font/poppins" />

                    <EditText
                        android:id="@+id/et_activation_phrase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_box"
                        android:hint="e.g. Help Me AtmaRaksha"
                        android:minHeight="46dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Help Me AtmaRaksha"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_bold" />

                    <!-- Quick Phrase Suggestions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_phrase_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_button_lavender"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="Help Me AtmaRaksha"
                            android:textColor="@color/brand_purple"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/chip_phrase_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_input_box"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="Emergency SOS"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/chip_phrase_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_input_box"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="Safe Circle Help"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_save_phrase"
                        style="@style/Widget.AtmaRaksha.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="10dp"
                        android:minHeight="38dp"
                        android:text="Save Phrase"
                        android:textSize="11sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Technical & Android Limitation Transparency Card -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.AtmaRaksha.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button_lavender"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="TRANSPARENT SYSTEM DISCLOSURE"
                        android:textColor="@color/brand_purple"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• 🎤 Microphone Permission: Audio data is processed strictly on-device for phrase matching. No voice recording is stored or sent to remote servers.\n• 🔋 Battery Usage: Continuous microphone capture consumes increased device battery.\n• 📱 Android Background Execution Limitation: Modern Android OS power-management actively restricts indefinite background microphone capture without user visibility. For maximum reliability, keep Voice SOS armed while navigating or traveling alone."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        app:fontFamily="@font/poppins" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Manual SOS Alternative Bar (Always Accessible) -->
    <LinearLayout
        android:id="@+id/bottom_manual_sos_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Manual SOS alternative is always available"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_manual_sos_alternative"
            style="@style/Widget.AtmaRaksha.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/color_sos_red"
            android:minHeight="48dp"
            android:text="🚨 Trigger Manual Emergency SOS"
            android:textSize="13sp"
            android:textStyle="bold"
            app:fontFamily="@font/poppins_bold" />
    </LinearLayout>

</RelativeLayout>
