<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fitsSystemWindows="true">

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_nearby"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/emergency_quick_bar"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header Banner -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:id="@+id/btn_back_nearby"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="Nearby Help"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/poppins_bold" />

                <!-- Segmented Toggle: [ List | Map ] matching SheRoute reference -->
                <LinearLayout
                    android:id="@+id/toggle_list_map_container"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_below="@id/btn_back_nearby"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_segmented_toggle"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/toggle_btn_list"
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_toggle_item_active"
                        android:gravity="center"
                        android:text="List"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:id="@+id/toggle_btn_map"
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Map"
                        android:textColor="@color/brand_purple"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_medium" />
                </LinearLayout>

            </RelativeLayout>

            <!-- Search Bar & Filter Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_search_nearby"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:hint="Search nearby help..."
                        android:inputType="text"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="13sp"
                        app:fontFamily="@font/poppins" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_filter_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_button_lavender"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/brand_purple" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Filter"
                        android:textColor="@color/brand_purple"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Horizontal Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button_pink"
                        android:paddingStart="14dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        android:text="All Services"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:id="@+id/filter_police"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_button_lavender"
                        android:paddingStart="14dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        android:text="🚓 Police Stations"
                        android:textColor="@color/brand_purple"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:id="@+id/filter_hospital"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_button_lavender"
                        android:paddingStart="14dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        android:text="🏥 Hospitals"
                        android:textColor="@color/brand_purple"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:id="@+id/filter_pharmacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_button_lavender"
                        android:paddingStart="14dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        android:text="💊 24/7 Pharmacies"
                        android:textColor="@color/brand_purple"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_medium" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Radius Selection Chips (1km, 3km, 5km, 10km) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Radius:"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/poppins_bold" />

                <TextView
                    android:id="@+id/chip_radius_1km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_button_lavender"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="1 km"
                    android:textColor="@color/brand_purple"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chip_radius_3km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_button_pink"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="3 km"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_radius_5km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_button_lavender"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="5 km"
                    android:textColor="@color/brand_purple"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chip_radius_10km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_button_lavender"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="10 km"
                    android:textColor="@color/brand_purple"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Cards Container (List View) -->
            <LinearLayout
                android:id="@+id/container_services_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Loading Progress -->
                <ProgressBar
                    android:id="@+id/progress_nearby_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:indeterminateTint="@color/brand_pink"
                    android:visibility="gone" />

                <!-- Empty State Layout -->
                <LinearLayout
                    android:id="@+id/layout_nearby_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tv_nearby_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No Verified Facilities Found"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:id="@+id/tv_nearby_empty_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="No facilities found in current radius.\nTry expanding to 5 km or 10 km."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Dynamic Places Container -->
                <LinearLayout
                    android:id="@+id/layout_dynamic_places_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 1. Police Station Card (SheRoute reference: Littlefield Police Station - 500 m • 7 min) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_service_police"
                    style="@style/Widget.AtmaRaksha.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_pill_button_lavender">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_police_badge"
                                    app:tint="@color/brand_purple" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Police Station (Littlefield Precinct)"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    app:fontFamily="@font/poppins_bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="500 m • 7 min walk • 24/7 Women's Helpdesk"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    app:fontFamily="@font/poppins" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_button_lavender"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="Verified"
                                android:textColor="@color/brand_purple"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                app:fontFamily="@font/poppins_medium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btn_locate_police"
                                style="@style/Widget.AtmaRaksha.Button.Primary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="42dp"
                                android:text="Find on Maps"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btn_call_police"
                                style="@style/Widget.AtmaRaksha.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:minHeight="42dp"
                                android:text="Call 100 / 112"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. Hospital Card (SheRoute reference: Pinewood General - 750 m • 9 min) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_service_hospital"
                    style="@style/Widget.AtmaRaksha.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_pill_button_lavender">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_hospital"
                                    app:tint="@color/color_sos_red" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Hospital (Pinewood General Hospital)"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    app:fontFamily="@font/poppins_bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="750 m • 9 min walk • 24/7 Trauma Emergency"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    app:fontFamily="@font/poppins" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_button_pink"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="24/7 ER"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                app:fontFamily="@font/poppins_medium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btn_locate_hospital"
                                style="@style/Widget.AtmaRaksha.Button.Primary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="42dp"
                                android:text="Find on Maps"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btn_call_hospital"
                                style="@style/Widget.AtmaRaksha.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:minHeight="42dp"
                                android:text="Call 108"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. Pharmacy Card (SheRoute reference: 24-Hour Pharmacy - 250 m • 4 min) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_service_pharmacy"
                    style="@style/Widget.AtmaRaksha.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_pill_button_lavender">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_pharmacy"
                                    app:tint="@color/brand_pink" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="24-Hour Pharmacy &amp; Safe Haven"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    app:fontFamily="@font/poppins_bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="250 m • 4 min walk • Well-lit safe sanctuary"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    app:fontFamily="@font/poppins" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_button_lavender"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="Open Now"
                                android:textColor="@color/brand_purple"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                app:fontFamily="@font/poppins_medium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btn_locate_pharmacy"
                                style="@style/Widget.AtmaRaksha.Button.Primary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="42dp"
                                android:text="Find on Maps"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btn_call_pharmacy"
                                style="@style/Widget.AtmaRaksha.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:minHeight="42dp"
                                android:text="Get Directions"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Map View Container (Shown when user taps [ Map ] toggle) -->
            <LinearLayout
                android:id="@+id/container_services_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    style="@style/Widget.AtmaRaksha.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗺️ Nearby Safety Hubs &amp; Patrol Checkpoints"
                            android:textColor="@color/brand_purple"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Verified emergency posts surrounding your current GPS fix:"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:fontFamily="@font/poppins" />

                        <!-- Embedded OpenStreetMap -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            android:layout_marginTop="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <org.osmdroid.views.MapView
                                    android:id="@+id/mapview_nearby_help"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:layout_alignParentStart="true"
                                    android:layout_margin="6dp"
                                    android:background="#A0FFFFFF"
                                    android:paddingStart="6dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="6dp"
                                    android:paddingBottom="2dp"
                                    android:text="© OpenStreetMap contributors • Overpass"
                                    android:textColor="#333333"
                                    android:textSize="8sp" />
                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>

                        <Button
                            android:id="@+id/btn_open_external_map_all"
                            style="@style/Widget.AtmaRaksha.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:minHeight="48dp"
                            android:text="Explore All Safety Points on Map"
                            android:textSize="13sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Emergency Quick Bar (Responsive with flexible buttons) -->
    <LinearLayout
        android:id="@+id/emergency_quick_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/brand_purple"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Dial:"
            android:textColor="@color/brand_lavender"
            android:textSize="12sp"
            android:textStyle="bold"
            app:fontFamily="@font/poppins_bold" />

        <Button
            android:id="@+id/btn_fast_112"
            style="@style/Widget.AtmaRaksha.Button.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/brand_pink"
            android:minHeight="38dp"
            android:text="112 National"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_fast_1091"
            style="@style/Widget.AtmaRaksha.Button.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/brand_lavender"
            android:minHeight="38dp"
            android:text="1091 Women"
            android:textColor="@color/brand_purple"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
