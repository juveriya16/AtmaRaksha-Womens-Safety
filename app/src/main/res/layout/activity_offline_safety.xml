<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header Banner -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <ImageView
                    android:id="@+id/btn_back_offline"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="Offline Safety Shield"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/poppins_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="26dp"
                    android:text="Accessible anytime • Zero internet required"
                    android:textColor="@color/brand_lavender"
                    android:textSize="11sp"
                    app:fontFamily="@font/poppins" />

                <!-- Offline Guaranteed Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_pill_button_lavender"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="📶 Offline Ready"
                    android:textColor="@color/brand_purple"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- 1. Offline Emergency Circle Quick Actions -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.AtmaRaksha.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 Offline Guardian Contact Dispatch"
                        android:textColor="@color/brand_purple"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Dial directly or handoff emergency SMS to your default messaging app without mobile data:"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        app:fontFamily="@font/poppins" />

                    <!-- Dynamic Cached Contacts Container -->
                    <LinearLayout
                        android:id="@+id/container_offline_contacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <!-- Delivery Status Transparency Notice -->
                    <TextView
                        android:id="@+id/tv_offline_delivery_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_pill_button_lavender"
                        android:padding="10dp"
                        android:text="ℹ️ Transparent Delivery Reporting: Offline alerts are handed off to your phone's cellular SMS composer or carrier dialer. AtmaRaksha reports carrier delivery only when network receipts are confirmed."
                        android:textColor="@color/brand_purple"
                        android:textSize="11sp"
                        app:fontFamily="@font/poppins" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. Essential Emergency Helplines (Works Offline via Telecom) -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.AtmaRaksha.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨 National Emergency Helplines (Toll-Free)"
                        android:textColor="@color/brand_purple"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_dial_112"
                            style="@style/Widget.AtmaRaksha.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="42dp"
                            android:text="Dial 112 (National)"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_dial_1091"
                            style="@style/Widget.AtmaRaksha.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:minHeight="42dp"
                            android:text="Dial 1091 (Women)"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_dial_181"
                            style="@style/Widget.AtmaRaksha.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="42dp"
                            android:text="Dial 181 (Domestic)"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_dial_108"
                            style="@style/Widget.AtmaRaksha.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:minHeight="42dp"
                            android:text="Dial 108 (Ambulance)"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Offline Legal Rights & Protections Guide -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.AtmaRaksha.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚖️ Legal Rights &amp; Protections Guide"
                        android:textColor="@color/brand_purple"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• Zero FIR Right: A woman can lodge an FIR at any police station regardless of jurisdiction or where the incident took place.\n• Arrest of Women (CrPC Sec 46): No woman can be arrested after sunset and before sunrise, except in unavoidable circumstances with prior magistrate order and in the presence of a female officer.\n• Free Legal Aid: Women are entitled to free legal counsel and representation under Section 12 of the Legal Services Authorities Act.\n• Right to Confidentiality: A victim of sexual assault has the right to complete privacy and identity protection (IPC Sec 228A)."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        app:fontFamily="@font/poppins" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. Offline Self-Defense Physical Tactics -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.AtmaRaksha.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥋 Practical Physical Defense Essentials"
                        android:textColor="@color/brand_purple"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="1. Target High-Vulnerability Zones: Eyes, nose bridge, throat, groin, and shins requires minimal force to create an escape window.\n2. Wrist-Grab Release: Rotate your wrist toward the attacker's thumb where their grip is weakest, pull forcefully back toward your shoulder.\n3. Bear-Hug Defense: Drop your center of gravity immediately, stomp downward on the attacker's instep, and strike backward with your elbow.\n4. Scream 'Fire' or 'Police': Research proves yelling 'Fire!' generates immediate neighborhood attention faster than generic calls for help."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        app:fontFamily="@font/poppins" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
