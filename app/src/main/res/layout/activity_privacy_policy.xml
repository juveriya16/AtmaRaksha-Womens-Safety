<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fitsSystemWindows="true">

    <!-- Scrollable Terms & Policy -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_policy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_consent_bar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Top Header Banner -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <ImageView
                    android:id="@+id/btn_back_policy"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/btn_back_policy"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Privacy &amp; Safety Consent"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Version 1.0 • Complete transparency for your safety"
                        android:textColor="@color/brand_lavender"
                        android:textSize="12sp"
                        app:fontFamily="@font/poppins" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Main Policy Card -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.AtmaRaksha.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Our Sacred Promise to You"
                        android:textColor="@color/brand_purple"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:text="AtmaRaksha (SheRoute Edition) is created with a single, uncompromising mission: protecting women with absolute respect for personal dignity, confidential data, and device autonomy."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        app:fontFamily="@font/poppins" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/card_border" />

                    <!-- Section 1: Location -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Real-Time GPS &amp; Location Access"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• Purpose: Your GPS coordinates are retrieved strictly to attach your real-time location link to SOS emergency alerts, Journey Sharing, and nearby emergency services discovery.\n• On-Demand Only: AtmaRaksha never logs or tracks your background movements without your explicit knowledge or unless SOS / Journey Sharing is active.\n• No Third-Party Tracking: Your coordinates are never uploaded to advertisers or external commercial brokers."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:fontFamily="@font/poppins" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/card_border" />

                    <!-- Section 2: SMS & Calling -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Emergency SMS &amp; Phone Calls"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• User Confirmation First: The app will never automatically place emergency calls or send messages without explicit user confirmation or expiration of the visible 5-second cancel countdown.\n• Fallback Support: If direct SMS permission is restricted by your device or Android policy, AtmaRaksha opens your default SMS app with the guardian numbers and emergency GPS message pre-filled for one-tap review and dispatch."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:fontFamily="@font/poppins" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/card_border" />

                    <!-- Section 3: Data Storage -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Storage of Contacts &amp; Safety Logs"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• Local Sandboxing: Your trusted contacts, customized SOS messages, and safety event logs are stored locally on your device in private app sandboxed storage.\n• User Ownership: You can view, export, edit, or wipe your safety history and saved numbers at any time from the app settings."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:fontFamily="@font/poppins" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/card_border" />

                    <!-- Section 4: Safe Route Model -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Safe Route Model Transparency"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• Evaluated Factors: Safe routes are assessed based on street lighting telemetry, proximity to verified 24/7 safe havens and police patrol points.\n• Prototype Notice: When third-party routing APIs or external municipal feeds are not connected, the app provides a clearly labelled prototype evaluation based on local algorithmic benchmarks."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:fontFamily="@font/poppins" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Consent & Action Bar -->
    <LinearLayout
        android:id="@+id/bottom_consent_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_accept_policy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/brand_pink"
                android:checked="false" />

            <TextView
                android:id="@+id/tv_checkbox_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="I have read, understood, and accept the AtmaRaksha Privacy Policy &amp; Terms of Protection."
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:fontFamily="@font/poppins_medium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_decline_policy"
                style="@style/Widget.AtmaRaksha.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:strokeColor="@color/grey_400"
                android:text="Decline &amp; Exit"
                android:textColor="@color/grey_700"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_accept_policy"
                style="@style/Widget.AtmaRaksha.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1.6"
                android:enabled="false"
                android:text="Accept &amp; Continue"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
